@using Microsoft.AspNetCore.Http.Extensions
@inject Ricebird.Wechat.Services.CorpWechatService wechatService
@{
    string successIcon = """<svg id="success" class="success" focusable="false" data-icon="check-circle" width="1em" height="1em" fill="currentColor" aria-hidden="true" viewBox="64 64 896 896"><path d="M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64zm193.5 301.7l-210.6 292a31.8 31.8 0 01-51.7 0L318.5 484.9c-3.8-5.3 0-12.7 6.5-12.7h46.9c10.2 0 19.9 4.9 25.9 13.3l71.2 98.8 157.2-218c6-8.3 15.6-13.3 25.9-13.3H699c6.5 0 10.3 7.4 6.5 12.7z"></path></svg>""";
    string errorIcon = """<svg id="error" class="error" focusable="false" data-icon="close-circle" width="1em" height="1em" fill="currentColor" aria-hidden="true" fill-rule="evenodd" viewBox="64 64 896 896"><path d="M512 64c247.4 0 448 200.6 448 448S759.4 960 512 960 64 759.4 64 512 264.6 64 512 64zm127.98 274.82h-.04l-.08.06L512 466.75 384.14 338.88c-.04-.05-.06-.06-.08-.06a.12.12 0 00-.07 0c-.03 0-.05.01-.09.05l-45.02 45.02a.2.2 0 00-.05.09.12.12 0 000 .07v.02a.27.27 0 00.06.06L466.75 512 338.88 639.86c-.05.04-.06.06-.06.08a.12.12 0 000 .07c0 .03.01.05.05.09l45.02 45.02a.2.2 0 00.09.05.12.12 0 00.07 0c.02 0 .04-.01.08-.05L512 557.25l127.86 127.87c.04.04.06.05.08.05a.12.12 0 00.07 0c.03 0 .05-.01.09-.05l45.02-45.02a.2.2 0 00.05-.09.12.12 0 000-.07v-.02a.27.27 0 00-.05-.06L557.25 512l127.87-127.86c.04-.04.05-.06.05-.08a.12.12 0 000-.07c0-.03-.01-.05-.05-.09l-45.02-45.02a.2.2 0 00-.09-.05.12.12 0 00-.07 0z"></path></svg>""";
    string infoIcon = """<svg id="info" class="info" focusable="false" data-icon="exclamation-circle" width="1em" height="1em" fill="currentColor" aria-hidden="true" viewBox="64 64 896 896"><path d="M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64zm-32 232c0-4.4 3.6-8 8-8h48c4.4 0 8 3.6 8 8v272c0 4.4-3.6 8-8 8h-48c-4.4 0-8-3.6-8-8V296zm32 440a48.01 48.01 0 010-96 48.01 48.01 0 010 96z"></path></svg>""";
    string connId = Context.Request.Query["connId"].ToString();
    var config = wechatService.GetSignature(Context.Request.GetDisplayUrl());
}
<!DOCTYPE html>
<html>
    <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1">
        <title>提示</title>
        <style>
            .result {
                margin-top: 36px;
                font-size: 14px;
                box-sizing: border-box;
            }
            .result-icon {
                margin-bottom: 24px;
                text-align: center;
                font-size: 72px;
            }
            .success {
                color: #52c41a;
            }
            .error {
                color: #ff4d4f;
            }
            .info {
                color: #1677ff;
            }
            .result-title {
                color: rgba(0, 0, 0, 0.88);
                font-size: 24px;
                line-height: 1.5;
                margin-block: 8px;
                text-align: center;
            }
        </style>
    </head>
    <body>
    <div class="result">
        <div class="result-icon">
            @Html.Raw(successIcon)
            @Html.Raw(errorIcon)
            @Html.Raw(infoIcon)
        </div>
    </div>
    <div class="result-title" id="title">
        正在获取地理位置
    </div>
    <script src="//res.wx.qq.com/open/js/jweixin-1.2.0.js"></script>
    <script>
        const successIcon = document.getElementById("success");
        const errorIcon = document.getElementById("error");
        const infoIcon = document.getElementById("info");
        const title = document.getElementById("title");
        function showInfo(msg) {
            successIcon.style.display = "none";
            errorIcon.style.display = "none";
            infoIcon.style.display = "inline";
            title.innerHTML = msg;
        }

        function showSuccess(msg) {
            infoIcon.style.display = "none";
            errorIcon.style.display = "none";
            successIcon.style.display = "inline";
            title.innerHTML = msg;
        }

        function showError(msg) {
            successIcon.style.display = "none";
            infoIcon.style.display = "none";
            errorIcon.style.display = "inline";
            title.innerHTML = msg;
        }
    </script>
    <script>
        showInfo("正在注册企业信息");
        wx.config({
            beta: true,// 必须这么写，否则wx.invoke调用形式的jsapi会有问题
            debug: false, // 开启调试模式,调用的所有api的返回值会在客户端alert出来，若要查看传入的参数，可以在pc端打开，参数信息会通过log打出，仅在pc端时才会打印。
            appId: '@config.appId', // 必填，企业微信的corpID，必须是本企业的corpID，不允许跨企业使用
            timestamp: '@config.timestamp', // 必填，生成签名的时间戳
            nonceStr: '@config.nonceStr', // 必填，生成签名的随机串
            signature: '@config.signature',// 必填，签名，见 附录-JS-SDK使用权限签名算法
            jsApiList: [
                "getLocation"
            ] // 必填，需要使用的JS接口列表，凡是要调用的接口都需要传进来
        });

        wx.ready(function () {
            showInfo("正在获取地理位置");
            wx.getLocation({
                type: 'wgs84', // 默认为wgs84的gps坐标，如果要返回直接给openLocation用的火星坐标，可传入'gcj02'
                success: function (res) {
                    var latitude = res.latitude; // 纬度，浮点数，范围为90 ~ -90
                    var longitude = res.longitude; // 经度，浮点数，范围为180 ~ -180。

                    showSuccess("获取成功");
                    let geo = `${latitude},${longitude}`;

                    let url = "/api/wechat/corp/PostGeoInfo";
                    const headers = new Headers();
                    headers.append("Content-Type", "application/json")
                    const data = {
                        connId: '@connId',
                        geo
                    };
                    const req = fetch(url, {
                        method: 'POST',
                        headers,
                        body: JSON.stringify(data)
                    });
                    req.then(res => {
                        showSuccess("已向服务器上报地址");
                    });
                },
                fail () {
                    showError("获取失败");
                }
            });
        })
    </script>
    </body>
</html>
