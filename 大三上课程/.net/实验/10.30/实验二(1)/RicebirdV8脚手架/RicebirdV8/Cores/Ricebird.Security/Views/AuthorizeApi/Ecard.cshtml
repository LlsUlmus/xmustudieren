@model Ricebird.Security.ViewModels.EcardCallbackViewModel
@{
    string url = Model.IsMobile ? $"{Model.Domain}/mobile?v={Random.Shared.Next(10000)}" : "/authen/login";
    url = string.IsNullOrWhiteSpace(Model.RedirectUrl) ? url : Model.RedirectUrl;
    if (Model.IsMobile)
    {
        string divider = url.Contains("?") ? "&" : "?";
        url = $"{url}{divider}{Model.AccessToken.TokenKey}={Model.AccessToken.Token}";
    }
}
<html>
<head>
    <title>统一认证登录回调</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1">
    <style>body { font-size: 18px;}</style>
</head>
<body>
    @* <div id="res">
        @(Model.IsMobile)<br />
        url: @url
    </div> *@
    <script>
        let token = "@Model.Token";
        localStorage.setItem("access_token", token);
        localStorage.setItem("is_work_wechat", @(Model.IsWorkWechat ? "true" : "false"));
        location.href = "@Html.Raw(url)";
    </script>
</body>
</html>