<Window x:Class="HomeworkGrader.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="统计分析" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2E86AB" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊 统计分析" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <Button Content="🔄 刷新" Margin="20,0,0,0" Padding="8,4" Background="Transparent" 
                        Foreground="White" BorderBrush="White" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 筛选条件 -->
            <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="1" 
                    CornerRadius="5" Padding="15" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="课程:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding CourseNames}" SelectedItem="{Binding SelectedCourse}" 
                              Width="150" Margin="0,0,20,0"/>
                    
                    <TextBlock Text="班级:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding ClassNames}" SelectedItem="{Binding SelectedClass}" 
                              Width="150" Margin="0,0,20,0"/>
                </StackPanel>
            </Border>

            <!-- 统计内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：基本统计 -->
                <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" 
                        CornerRadius="5" Padding="15" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="基本统计" FontSize="16" FontWeight="Bold" 
                                   Margin="0,0,0,15"/>

                        <StackPanel Grid.Row="1">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="总作业数:" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Statistics.TotalAssignments}" 
                                           HorizontalAlignment="Right" Foreground="#2E86AB"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="总提交数:" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Statistics.TotalSubmissions}" 
                                           HorizontalAlignment="Right" Foreground="#A23B72"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="已批改数:" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Statistics.GradedSubmissions}" 
                                           HorizontalAlignment="Right" Foreground="#28A745"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="平均分:" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Statistics.AverageGrade, StringFormat=F2}" 
                                           HorizontalAlignment="Right" Foreground="#F18F01"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="最高分:" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Statistics.HighestGrade}" 
                                           HorizontalAlignment="Right" Foreground="#C73E1D"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="最低分:" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Statistics.LowestGrade}" 
                                           HorizontalAlignment="Right" Foreground="#6C757D"/>
                            </Grid>

                            <Separator Margin="0,15,0,15"/>

                            <TextBlock Text="批改率" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ProgressBar Value="{Binding Path=Statistics.GradedSubmissions}" 
                                         Maximum="{Binding Path=Statistics.TotalSubmissions}"
                                         Height="20" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Path=Statistics.GradedSubmissions, Converter={StaticResource PercentageConverter}}" 
                                       HorizontalAlignment="Center" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 右侧：成绩分布 -->
                <Border Grid.Column="1" Background="White" BorderBrush="#DDD" BorderThickness="1" 
                        CornerRadius="5" Padding="15" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="成绩分布" FontSize="16" FontWeight="Bold" 
                                   Margin="0,0,0,15"/>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding GradeDistribution}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="12"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding Value}" 
                                                     Maximum="{Binding Path=DataContext.Statistics.TotalSubmissions, 
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Height="20" Margin="10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" 
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="10">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="Gray"/>
        </Border>
    </Grid>
</Window>

