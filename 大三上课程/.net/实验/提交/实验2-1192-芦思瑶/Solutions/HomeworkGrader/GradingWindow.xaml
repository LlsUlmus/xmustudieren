<Window x:Class="HomeworkGrader.GradingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批改作业" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2E86AB" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📝 批改作业" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="LightGray" 
                           Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：学生列表 -->
            <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="学生提交列表" FontSize="16" FontWeight="Bold" 
                               Margin="15,15,15,10"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Submissions}" 
                             SelectedItem="{Binding CurrentSubmission}"
                             Margin="15,0,15,15">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" 
                                        CornerRadius="3" Padding="10" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StudentName}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StudentId}" FontSize="11" Foreground="Gray"/>
                                        <TextBlock Text="{Binding SubmittedDate, StringFormat=yyyy-MM-dd HH:mm}" 
                                                   FontSize="11" Foreground="Gray"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="状态:" FontSize="11" Foreground="Gray"/>
                                            <TextBlock Text="{Binding IsGraded, Converter={StaticResource BoolToStatusConverter}}" 
                                                       FontSize="11" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 中间：文件内容 -->
            <Border Grid.Column="1" Background="White" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="15,15,15,10">
                        <TextBlock Text="文件内容" FontSize="16" FontWeight="Bold"/>
                        <Button Content="📁 打开文件" Margin="20,0,0,0" Padding="8,4"
                                Command="{Binding ViewFileCommand}" CommandParameter="{Binding CurrentSubmission}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="15,0,15,15">
                        <TextBox Text="{Binding FileContent}" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 IsReadOnly="True"
                                 Background="#FAFAFA"
                                 BorderThickness="0"
                                 Padding="10"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右侧：批改面板 -->
            <Border Grid.Column="2" Background="#F8F9FA">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 学生信息 -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="1" 
                            CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentSubmission.StudentName}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentSubmission.StudentId}" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding CurrentSubmission.SubmittedDate, StringFormat=提交时间: yyyy-MM-dd HH:mm}" 
                                       FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding CurrentSubmission.IsLate, Converter={StaticResource BoolToLateConverter}}" 
                                       FontSize="12" Foreground="Red"/>
                        </StackPanel>
                    </Border>

                    <!-- 成绩输入 -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="成绩 (0-100)" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Grade}" FontSize="16" Padding="8"/>
                    </StackPanel>

                    <!-- 评语输入 -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="评语" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Feedback}" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 Height="100"
                                 Padding="8"/>
                    </StackPanel>

                    <!-- 批改人 -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <TextBlock Text="批改人" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding GraderName}" Padding="8"/>
                    </StackPanel>

                    <!-- 空白区域 -->
                    <Grid Grid.Row="4"/>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="⬅️ 上一个" Width="80" Height="35" Margin="0,0,10,0" 
                                Command="{Binding PreviousCommand}"/>
                        <Button Content="批改" Width="80" Height="35" Margin="0,0,10,0" 
                                Command="{Binding GradeSubmissionCommand}" 
                                CommandParameter="{Binding CurrentSubmission}"
                                Background="#28A745" Foreground="White"/>
                        <Button Content="下一个 ➡️" Width="80" Height="35" 
                                Command="{Binding NextCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="当前:" FontSize="12" Foreground="Gray"/>
                <TextBlock Text="{Binding CurrentIndex}" FontSize="12" Foreground="Gray" Margin="5,0,0,0"/>
                <TextBlock Text="/" FontSize="12" Foreground="Gray" Margin="5,0,0,0"/>
                <TextBlock Text="{Binding Submissions.Count}" FontSize="12" Foreground="Gray" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

