            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">authentication</stringProp>
              <stringProp name="Header.value">eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjQsImV4cCI6MTc3OTYxOTQ2OH0.lkol2sjty5k1JMwX0BdpDBMWCdh9BZT5sWPyWMECWls</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
